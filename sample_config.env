# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
USER_SESSION_STRING=""
OWNER_ID=""

# Admin login (recommended: set both values in Hugging Face Secrets / config.env)
# If both are supplied, they safely override old credentials saved in MongoDB.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"
